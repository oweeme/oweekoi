[Desktop Entry]
Type=Service
Name=Color de carpeta
MimeType=inode/directory;
Actions=rojo;naranja;amarillo;verde;turquesa;azul;violeta;rosa;gris;quitar;
X-KDE-Submenu=Color de carpeta
Icon=folder-owee-azul

[Desktop Action rojo]
Name=Rojo
Icon=folder-owee-rojo
Exec=owee-carpeta rojo %F

[Desktop Action naranja]
Name=Naranja
Icon=folder-owee-naranja
Exec=owee-carpeta naranja %F

[Desktop Action amarillo]
